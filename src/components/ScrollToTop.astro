---

<button id="scroll-top" class="fixed bottom-8 right-8 bg-[var(--ubuntu-orange)] text-white w-12 h-12 rounded-full shadow-lg hover:shadow-xl transition-all duration-300 hidden items-center justify-center text-2xl z-50 hover:-translate-y-0.5" aria-label="Scroll to top">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
</button>

<script>
  const scrollBtn = document.getElementById('scroll-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 500) {
      scrollBtn?.classList.remove('hidden');
      scrollBtn?.classList.add('flex');
    } else {
      scrollBtn?.classList.add('hidden');
      scrollBtn?.classList.remove('flex');
    }
  });

  scrollBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
